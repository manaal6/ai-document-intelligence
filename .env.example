# AI Document Intelligence Assistant — Environment Variables
# Copy this file to .env and adjust values as needed.

# ── Application ─────────────────────────────────────────────
DEBUG=true

# ── Groq (Free Cloud LLM — get key at https://console.groq.com) ──
GROQ_API_KEY=gsk_your_free_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Embeddings ──────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── ChromaDB ────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=document_chunks

# ── RAG Settings ────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# ── LLM Settings ────────────────────────────────────────────
MAX_TOKENS=2048
TEMPERATURE=0.3

# ── Upload Limits ───────────────────────────────────────────
MAX_FILE_SIZE_MB=20
